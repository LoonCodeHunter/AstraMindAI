{
  "name": "astramind-vscode",
  "displayName": "AstraMindAI",
  "description": "AI assistant integrated into VS Code.",
  "version": "1.0.0",
  "publisher": "LoonCodeHunter",
  "private": true,

  "engines": {
    "vscode": "^1.80.0"
  },

  "categories": ["AI", "Productivity", "Development", "Machine Learning"],

  "activationEvents": [
    "onCommand:astramind.chat",
    "onCommand:astramind.explainCode",
    "onCommand:astramind.generateDocs",
    "onCommand:astramind.refactor",
    "onCommand:astramind.switchModel",
    "onView:astramind.chatView"
  ],

  "main": "./dist/extension.js",

  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "astramind",
          "title": "AstraMind",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "astramind": [
        {
          "id": "astramind.chatView",
          "name": "AstraMind Chat"
        }
      ]
    },
    "commands": [
      { "command": "astramind.chat", "title": "AstraMind: Chat" },
      { "command": "astramind.explainCode", "title": "AstraMind: Explain Code" },
      { "command": "astramind.generateDocs", "title": "AstraMind: Generate Docs" },
      { "command": "astramind.refactor", "title": "AstraMind: Refactor Code" },
      { "command": "astramind.switchModel", "title": "AstraMind: Switch Model" }
    ]
  },

  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "package": "vsce package",
    "typecheck": "tsc --noEmit"
  },

  "dependencies": {
    "axios": "^1.7.7"
  },

  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "vscode": "^1.80.0",
    "eslint": "^9.15.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "vitest": "^2.1.0",
    "vsce": "^2.15.0"
  }
}
