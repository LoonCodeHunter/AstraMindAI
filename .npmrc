# Use pnpm as the package manager
package-manager=pnpm

# Always save exact versions
save-exact=true

# Disable npm lockfile generation
package-lock=false

# Enable workspaces
workspaces=true

# Registry configuration
registry=https://registry.npmjs.org/

# Increase network timeouts for large installs
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Strict SSL
strict-ssl=true

# Prefer offline cache when possible
prefer-offline=true

# Node linking strategy (pnpm)
node-linker=hoisted

# Auth token for publishing (optional)
# //registry.npmjs.org/:_authToken=${NPM_TOKEN}

# Prevent accidental publish of private packages
access=public
