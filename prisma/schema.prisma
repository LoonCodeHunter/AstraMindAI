datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  conversations Conversation[]
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())
  messages  Message[]
  summary   String?

  user User @relation(fields: [userId], references: [id])
}

model Message {
  id            String   @id @default(uuid())
  conversationId String
  role          String
  content       String
  createdAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model ModelRegistry {
  id        String   @id @default(uuid())
  name      String
  version   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  createdAt DateTime @default(now())
}

model UsageMetric {
  id        String   @id @default(uuid())
  metric    String
  value     Float
  createdAt DateTime @default(now())
}
