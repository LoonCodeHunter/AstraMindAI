# Core app
APP_NAME=AstraMindAI
APP_ENV=development
APP_PORT=3000

# Backend
BACKEND_URL=http://localhost:4000
BACKEND_LOG_LEVEL=info

# Frontend
FRONTEND_URL=http://localhost:3000

# ML service
ML_SERVICE_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/astramindai

# Auth
JWT_SECRET=replace_me_with_secure_random
JWT_EXPIRY=1h

# OpenAI / LLM provider (example)
LLM_PROVIDER=openai
LLM_API_KEY=replace_me
LLM_MODEL=gpt-4o-mini

# Redis / cache
REDIS_URL=redis://localhost:6379

# Feature flags
FEATURE_EXPERIMENTAL_UI=false
FEATURE_ADVANCED_ANALYTICS=true
