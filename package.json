{
  "name": "astramindai-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "AstraMindAI – full-stack AI platform with backend, frontend, worker, ML service, plugins, and VS Code extension.",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build --parallel",
    "lint": "turbo run lint --parallel",
    "test": "turbo run test --parallel",
    "typecheck": "turbo run typecheck --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "clean": "pnpm -r exec rm -rf node_modules dist .turbo",
    "install:all": "pnpm install && pnpm -r install",
    "update:all": "pnpm -r update --latest",
    "approve-builds": "pnpm approve-builds"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "flag": "^5.0.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "unused-imports": "0.0.1-security",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vsce": "^1.25.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "all": "^0.0.0"
  }
}
